{
  "name": "aquata",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev --workspace @aquata/server & npm run dev --workspace @aquata/web",
    "dev:server": "npm run dev --workspace @aquata/server",
    "dev:web": "npm run dev --workspace @aquata/web",
    "build": "npm run build --workspace @aquata/web",
    "start": "npm run start --workspace @aquata/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/rules && tsc -p apps/server && tsc -p apps/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
